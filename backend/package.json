{
  "name": "methmi-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "check:supabase": "node scripts/check-supabase.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:database": "vitest run --config vitest.database.config.ts",
    "test:types": "tsc --noEmit -p tsconfig.tests.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "resend": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "vitest": "^3.2.7"
  }
}
